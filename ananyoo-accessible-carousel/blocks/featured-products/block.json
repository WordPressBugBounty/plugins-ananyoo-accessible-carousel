{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "anacb/featured-products",
	"version": "2.9.1",
	"title": "Featured Products (WooCommerce)",
	"category": "ananyoo-accessible",
	"icon": "store",
	"description": "Show your WooCommerce Featured products inside an accessible card scroller or hero carousel. Per-element toggles, a description length limit, and a live WCAG contrast check for the category badge.",
	"keywords": [ "woocommerce", "products", "featured", "shop", "carousel", "scroller", "accessible" ],
	"textdomain": "ananyoo-accessible-carousel",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "padding": true, "margin": true }
	},
	"attributes": {
		"display":        { "type": "string",  "default": "scroller" },
		"style":          { "type": "string",  "default": "editorial" },
		"count":          { "type": "number",  "default": 8 },
		"perView":        { "type": "number",  "default": 3 },
		"category":       { "type": "string",  "default": "" },
		"orderby":        { "type": "string",  "default": "date" },
		"showHeading":    { "type": "boolean", "default": true },
		"heading":        { "type": "string",  "default": "Featured Products" },
		"headingLevel":   { "type": "number",  "default": 2 },
		"intro":          { "type": "string",  "default": "" },
		"showImage":      { "type": "boolean", "default": true },
		"showBadge":      { "type": "boolean", "default": true },
		"showTitle":      { "type": "boolean", "default": true },
		"showSubtitle":   { "type": "boolean", "default": true },
		"subtitleSource": { "type": "string",  "default": "excerpt" },
		"subtitleWords":  { "type": "number",  "default": 14 },
		"showPrice":      { "type": "boolean", "default": true },
		"showCta":        { "type": "boolean", "default": true },
		"ctaText":        { "type": "string",  "default": "View" },
		"ctaStyle":       { "type": "string",  "default": "link" },
		"badgeMode":      { "type": "string",  "default": "auto" },
		"badgeBg":        { "type": "string",  "default": "" },
		"badgeText":      { "type": "string",  "default": "#ffffff" },
		"label":          { "type": "string",  "default": "Featured products" }
	},
	"editorScript": "aac-editor",
	"editorStyle":  "aac-editor-style",
	"style":        [ "aac-scroller-style", "aac-style" ],
	"render":       "file:./render.php"
}
